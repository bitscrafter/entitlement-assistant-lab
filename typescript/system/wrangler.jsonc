{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entitlement-agent",
  "main": "application/entitlement-agent/src/worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "application/entitlement-agent/ui-dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:local-development-only@localhost:54329/entitlement_agent"
    }
  ]
}
