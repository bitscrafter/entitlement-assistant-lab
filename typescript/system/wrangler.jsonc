{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entitlement-assistant",
  "main": "application/entitlement-assistant/src/worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "application/entitlement-assistant/ui-dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "CASE_AGENT", "class_name": "CaseAgentObject" },
      { "name": "MESSAGE_RATE_LIMITER", "class_name": "MessageRateLimiterObject" },
      { "name": "DAILY_ALLOWANCE", "class_name": "DailyAllowanceObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CaseAgentObject", "MessageRateLimiterObject"] },
    { "tag": "v2", "new_sqlite_classes": ["DailyAllowanceObject"] }
  ],
  "workflows": [
    {
      "binding": "APPROVAL_PROCESS",
      "name": "entitlement-assistant-approval-process",
      "class_name": "ApprovalProcessWorkflow"
    }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "APPROVAL_WINDOW_SECONDS": "259200",
    "OUTBOX_RETRY_AFTER_SECONDS": "60",
    // The demo's AI budget (usage-guards D1): every usage cap derives from it; 10000 is Workers AI's daily free
    // allowance, so nothing is billed past it; "0" turns the assistant off.
    "AI_NEURONS_PER_DAY": "10000",
    // The estimated neurons of one model call: calibrate it from the dashboard (neurons used ÷ model calls).
    "NEURONS_PER_MODEL_CALL": "100"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "84702090e1e048eeb5970a7b2ab19fa0",
      "localConnectionString": "postgres://postgres:local-development-only@localhost:54329/entitlement_assistant"
    }
  ]
}
