{
  "name": "entitlement-assistant-system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node application/entitlement-assistant/src/database/migrate-command.ts",
    "db:seed": "node application/entitlement-assistant/src/database/seed-command.ts",
    "check": "biome ci --error-on-warnings && tsc --noEmit && tsc --noEmit -p application/entitlement-assistant/src/ui && depcruise . --config .dependency-cruiser.cjs && vitest run",
    "dev": "npm run ui:build && wrangler dev",
    "eval:live": "node application/entitlement-assistant/src/tools/live-evaluation-command.ts",
    "seed:passwords": "node application/entitlement-assistant/src/tools/create-seed-passwords-command.ts",
    "policies:build": "node application/entitlement-assistant/src/tools/build-policy-set-command.ts",
    "policies:register": "node application/entitlement-assistant/src/tools/register-policy-set-command.ts",
    "demo:reset": "node application/entitlement-assistant/src/tools/demo-reset-command.ts",
    "db:schema": "node application/entitlement-assistant/src/tools/schema-command.ts",
    "secrets:local": "node application/entitlement-assistant/src/tools/create-local-secrets-command.ts",
    "ui:build": "vite build --config application/entitlement-assistant/vite.config.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.157",
    "@cloudflare/ai-chat": "0.12.2",
    "@marcbachmann/cel-js": "8.0.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.30.1",
    "ai": "7.0.153",
    "canonicalize": "5.1.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uuid": "14.0.3",
    "workers-ai-provider": "4.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.7.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
